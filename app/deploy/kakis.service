[Unit]
Description=Kakis pilot app (FastAPI + DuckDB)
After=network.target

[Service]
Type=simple
User=kakis
WorkingDirectory=/home/kakis/eldercare/app
EnvironmentFile=/home/kakis/eldercare/app/.env
ExecStart=/home/kakis/eldercare/app/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
